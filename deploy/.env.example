# Copy to deploy/.env (ignored by git) and fill in. Docker Compose reads it automatically.

# Bearer token Alertmanager sends to Nexora's webhook. Must equal the single line in
# deploy/config/alertmanager_webhook_token (also ignored by git).
ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-long-random-value

# Step 4 investigator (optional): heuristic | anthropic | openai | ollama
RCA_PROVIDER=heuristic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Step 6 fix track (optional). Empty FIX_PROVIDER = same as RCA_PROVIDER (heuristic cannot write fixes).
# FIX_PROVIDER=anthropic
# GITHUB_TOKEN=   # fine-grained token with contents + pull requests write on the repository; opens draft PRs only
